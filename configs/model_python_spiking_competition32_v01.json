{
  "schema": "mstd-model-v1",
  "mt_backend": "python_spiking",
  "mt_radius": 0,
  "backend": "torch",
  "device": "cuda",
  "frame_ms": 50,
  "projection_config": "configs/v1_projection.json",
  "projection": "motionProj1",
  "spiking": {
    "dt_ms": 1.0,
    "substeps": 32,
    "seed": 43,
    "delay_ticks": 1,
    "feedback_delay_ticks": 1
  },
  "mstd_validity": {
    "mode": "geometry_support"
  },
  "mstd_readout": {
    "mode": "local_quadratic"
  },
  "mt_spatial": {
    "enabled": false,
    "radius": 2,
    "sigma_parallel_px": 1.5,
    "sigma_perpendicular_px": 0.75,
    "gain": 0.05,
    "tau_ms": 5.0,
    "delay_ticks": 1
  },
  "monitors": {
    "spikes": false,
    "neural_state": true,
    "every_n_frames": 1
  },
  "progress_every": 10,
  "mt_competition": {
    "enabled": true,
    "mode": "angular",
    "input_weight": 0.25,
    "inhibition_weight": 0.2,
    "tau_exc_ms": 5.0,
    "tau_inh_ms": 10.0,
    "input_delay_ticks": 1,
    "output_delay_ticks": 1
  }
}
